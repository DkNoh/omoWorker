    "domainName" : "발송이력조회",
    "rawQuery" : "SELECT                                             \n  A.SMS_HISTORY_ID AS SMS_HISTORY_ID,            \n  A.REQUEST_ID     AS REQUEST_ID,                \n  A.SENT_AT        AS SENT_AT,                   \n  A.RECEIVER_NO    AS RECEIVER_NO,               \n  A.SENDER_NO      AS SENDER_NO,                 \n  A.SEND_TYPE      AS SEND_TYPE,                 \n  A.SEND_STATUS    AS SEND_STATUS,               \n  A.RESULT_CD      AS RESULT_CD,                 \n  A.RESULT_MSG     AS RESULT_MSG                 \nFROM SMS.SMS_HISTORY A                             \nWHERE 1 = 1                                        \nAND A.SEND_TYPE = $send_type                     \nAND A.SEND_STATUS = $send_status                 \nAND A.SENT_AT between $start_dt and $end_dt      \nAND A.RECEIVER_NO LIKE '%' || $receiver_no || '%'",
