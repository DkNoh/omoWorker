    "rawQuery" : "SELECT\n    C.CUSTOMER_ID AS CUSTOMER_ID,\n    C.CUSTOMER_NM AS CUSTOMER_NM,\n    C.MOBILE_NO AS MOBILE_NO,\n    C.EMAIL AS EMAIL,\n    C.BIRTH_DT AS BIRTH_DT,\n    C.GENDER_CD AS GENDER_CD,\n    C.AGREE_YN AS AGREE_YN,\n    C.USE_YN AS USE_YN,\n    C.REG_DTTM AS REG_DTTM\nFROM SMS.CUSTOMER C\nWHERE 1 = 1\n  AND (C.CUSTOMER_NM LIKE '%' || $search_keyword || '%' OR C.MOBILE_NO LIKE '%' || $search_keyword || '%')\n  AND C.AGREE_YN = $agree_yn\n  AND C.USE_YN = $use_yn",
