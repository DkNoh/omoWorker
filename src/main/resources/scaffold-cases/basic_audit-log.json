    "rawQuery" : "SELECT\n    A.NOTICE_ID     AS NOTICE_ID,\n    A.TITLE         AS TITLE,\n    A.NOTICE_TYPE   AS NOTICE_TYPE,\n    A.USE_YN        AS USE_YN,\n    A.VIEW_CNT      AS VIEW_CNT,\n    A.REG_ID        AS REG_ID,\n    A.REG_DTTM      AS REG_DTTM,\n    A.UPD_ID        AS UPD_ID,\n    A.UPD_DTTM      AS UPD_DTTM\nFROM SMS.NOTICE A\nWHERE 1 = 1\n    AND A.REG_DTTM >= $startDate\n    AND A.REG_DTTM <  $endDate\n    AND A.REG_ID = $regId",
