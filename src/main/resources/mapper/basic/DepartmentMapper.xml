<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.scbk.sms.mapper.basic.DepartmentMapper">

    <!-- Scaffold 생성(v1). 생성 후 개발자가 직접 수정해 소유한다. -->
    <!-- 화면 DatePicker 검색값은 YYYYMMDD 문자열로 전달된다 (TuiPageBuilder 규약).
         비교 컬럼이 DATE/TIMESTAMP면 TO_DATE/TO_TIMESTAMP로 감싸고,
         단일 날짜 = 조건은 당일 00:00:00 이상, 다음날 00:00:00 미만 범위로 변환한다. -->

    <sql id="searchConditions">
        <where>
            <if test="searchkeyword != null and searchkeyword != ''">
                AND A.TITLE LIKE '%' || #{searchkeyword} || '%'
            </if>
            <if test="useyn != null and useyn != ''">
                AND A.USE_YN = #{useyn}
            </if>
        </where>
    </sql>

    <sql id="baseQuery">
            SELECT
                A.NOTICE_ID     AS NOTICE_ID,
                A.TITLE         AS TITLE,
                A.NOTICE_TYPE   AS NOTICE_TYPE,
                A.USE_YN        AS USE_YN,
                A.VIEW_CNT      AS VIEW_CNT,
                A.REG_ID        AS REG_ID,
                A.REG_DTTM      AS REG_DTTM
            FROM SMS.NOTICE A
    </sql>

    <select id="count" resultType="int">
        /* DepartmentMapper.count */
        SELECT COUNT(1) FROM (
        <include refid="baseQuery"/>
        ) A
        <include refid="searchConditions"/>
    </select>

    <select id="selectList" resultType="com.scbk.sms.vo.basic.DepartmentVO">
        /* DepartmentMapper.selectList */
        SELECT A.*
        FROM (
        <include refid="baseQuery"/>
        ) A
        <include refid="searchConditions"/>
        ORDER BY NOTICE_ID
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

</mapper>
