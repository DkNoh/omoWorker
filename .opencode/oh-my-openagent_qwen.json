{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      408,
      409,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 2,
    "cooldown_seconds": 60,
    "timeout_seconds": 120,
    "notify_on_fallback": true
  },

  "background_task": {
    "defaultConcurrency": 3,
    "staleTimeoutMs": 120000,
    "providerConcurrency": {
      "openai": 1,
      "dashscope": 2,
      "lmstudio": 1
    },
    "modelConcurrency": {
      "openai/gpt-5.6-sol": 1,
      "dashscope/qwen3.8-max-preview": 2,
      "lmstudio/qwen/qwen3.6-27b": 1
    }
  },

  "agents": {
    "sisyphus": {
      "model": "dashscope/qwen3.8-max-preview",
      "maxTokens": 16000,
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-sol",
          "reasoningEffort": "medium",
          "maxTokens": 12000
        },
        {
          "model": "lmstudio/qwen/qwen3.6-27b",
          "maxTokens": 8192
        }
      ]
    },

    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium",
      "maxTokens": 12000,
